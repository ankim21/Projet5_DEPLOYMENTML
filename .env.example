# Modele de configuration. NE PAS renommer ce fichier : le copier
#   cp .env.example .env
# puis remplacer changeme par un mot de passe a soi (lettres et chiffres).
# format : postgresql+psycopg://<utilisateur>:<mot_de_passe>@<hote>:<port>/<nom_de_la_base>
DATABASE_URL=postgresql+psycopg://futurisys:changeme@localhost:5432/futurisys
